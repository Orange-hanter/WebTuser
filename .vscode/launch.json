    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Dev Server (npm run dev)",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/event-app_v2",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]

    ,
    "compounds": [
        {
            "name": "Run Dev + Open Chrome",
            "configurations": ["Run Dev Server (npm run dev)", "Launch Chrome against localhost"]
        }
    ]
}