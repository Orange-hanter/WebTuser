{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Run Dev Server (npm run dev)",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/event-app_v2",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
        ,
        {
            "name": "Run Production (build then preview)",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/event-app_v2",
            "runtimeExecutable": "/bin/zsh",
            "runtimeArgs": ["-lc", "npm run build && npm run preview"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "name": "Preview Production (npm run preview)",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/event-app_v2",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "preview"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]

    ,
    "compounds": [
        {
            "name": "Run Dev + Preview",
            "configurations": ["Run Dev Server (npm run dev)", "Preview Production (npm run preview)"]
        }
    ]
}